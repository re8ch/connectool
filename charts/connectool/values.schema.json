{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["global", "dex", "toolhive", "codex"],
  "properties": {
    "global": {
      "type": "object",
      "required": ["issuer", "scopes"],
      "properties": {
        "issuer": {"type": "string", "pattern": "^https://"},
        "scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "dex": {
      "type": "object",
      "required": ["contract"],
      "properties": {"contract": {"type": "object", "required": ["enabled", "namespace"], "properties": {"enabled": {"type": "boolean"}, "namespace": {"type": "string", "minLength": 1}, "configMapName": {"type": "string"}}}}
    },
    "toolhive": {
      "type": "object",
      "required": ["namespace", "registry", "sessionStorage", "publications"],
      "properties": {
        "namespace": {"type": "string", "minLength": 1},
        "registry": {"type": "object", "required": ["enabled", "name", "sources"], "properties": {"enabled": {"type": "boolean"}, "name": {"type": "string", "minLength": 1}, "sources": {"type": "array"}}},
        "sessionStorage": {"type": "object", "required": ["provider", "address", "passwordSecretRef"], "properties": {"provider": {"const": "redis"}, "address": {"type": "string"}, "passwordSecretRef": {"type": "object", "required": ["name", "key"]}}},
        "publications": {"type": "array", "items": {"type": "object", "required": ["name", "clientId", "resourceUrl", "group", "workloads", "authorization"], "properties": {"name": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"}, "clientId": {"type": "string", "minLength": 1}, "resourceUrl": {"type": "string", "pattern": "^https://"}, "group": {"type": "string", "minLength": 1}, "workloads": {"type": "array", "minItems": 1}, "authorization": {"type": "object", "required": ["groupClaim", "policies"]}, "podTemplateSpec": {"type": "object"}}}}
      }
    },
    "codex": {
      "type": "object",
      "required": ["marketplace", "plugins"],
      "properties": {
        "marketplace": {
          "type": "object",
          "required": ["name", "displayName", "source", "publisher"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "displayName": {"type": "string", "minLength": 1},
            "source": {"type": "string", "pattern": "^https://"},
            "publisher": {
              "type": "object",
              "required": ["enabled", "repository", "branch", "schedule", "image", "secretRef", "author"],
              "properties": {
                "enabled": {"type": "boolean"},
                "repository": {"type": "string"},
                "branch": {"type": "string", "minLength": 1},
                "schedule": {"type": "string", "minLength": 1},
                "image": {"type": "string", "minLength": 1},
                "secretRef": {"type": "object", "required": ["name", "usernameKey", "tokenKey"], "properties": {"name": {"type": "string"}, "usernameKey": {"type": "string", "minLength": 1}, "tokenKey": {"type": "string", "minLength": 1}}},
                "author": {"type": "object", "required": ["name", "email"], "properties": {"name": {"type": "string", "minLength": 1}, "email": {"type": "string", "minLength": 3}}}
              }
            }
          }
        },
        "plugins": {"type": "array", "items": {"type": "object", "required": ["name", "publication", "mcpOwner", "skills", "version"], "properties": {"name": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"}, "publication": {"type": "string", "minLength": 1}, "mcpOwner": {"type": "boolean"}, "skills": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "content"], "properties": {"path": {"type": "string", "pattern": "^skills/[A-Za-z0-9._/-]+/SKILL\\.md$"}, "content": {"type": "string", "minLength": 40}}, "additionalProperties": false}}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "displayName": {"type": "string"}, "description": {"type": "string"}, "developerName": {"type": "string"}, "category": {"type": "string"}, "capabilities": {"type": "array", "items": {"type": "string"}}, "defaultPrompt": {"type": "string"}, "startupTimeoutSeconds": {"type": "integer", "minimum": 1}}, "additionalProperties": false}}
      }
    }
  }
}
